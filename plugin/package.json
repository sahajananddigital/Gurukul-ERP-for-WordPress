{
	"name": "gurukul-erp",
	"version": "1.0.0",
	"description": "Gurukul ERP for WordPress",
	"main": "src/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"test": "jest",
		"test:watch": "jest --watch",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"lint:php": "wp-scripts lint-php",
		"format:php": "wp-scripts format-php",
		"playground": "npx @wp-playground/cli@latest server --blueprint blueprint.json --mount '.:/wordpress/wp-content/plugins/plugin' --mount '../addons/gurukul-addon:/wordpress/wp-content/plugins/gurukul-addon'",
		"playground:debug": "npx @wp-playground/cli@latest server --blueprint blueprint.json --mount '.:/wordpress/wp-content/plugins/plugin' --mount '../addons/gurukul-addon:/wordpress/wp-content/plugins/gurukul-addon'",
		"open:playground": "open http://localhost:9400",
		"plugin-zip": "rm -rf release && mkdir -p release/sahajanand-erp && rsync -a --exclude='node_modules' --exclude='src' --exclude='.git' --exclude='.*' --exclude='package*.json' --exclude='specs' --exclude='tests' --exclude='*.config.js' --exclude='*.xml*' --exclude='composer.*' --exclude='blueprint.json' --exclude='*.log' --exclude='release' --exclude='sahajanand-erp.zip' . release/sahajanand-erp/ && cd release && zip -r ../sahajanand-erp.zip sahajanand-erp && cd .. && rm -rf release",
		"test:playwright": "wp-scripts test-playwright"
	},
	"keywords": [
		"wordpress",
		"erp",
		"crm",
		"accounting"
	],
	"author": "",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^6.1.0",
		"@testing-library/react": "^14.0.0",
		"@testing-library/user-event": "^14.5.0",
		"@wordpress/e2e-test-utils-playwright": "^2.0.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "^30.26.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^6.0.0",
		"@wordpress/components": "^25.0.0",
		"@wordpress/compose": "^6.0.0",
		"@wordpress/data": "^9.0.0",
		"@wordpress/dataviews": "^11.0.0",
		"@wordpress/element": "^5.0.0",
		"@wordpress/hooks": "^4.55.0",
		"@wordpress/i18n": "^4.0.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^7.18.4"
	}
}
