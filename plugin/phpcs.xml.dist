<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Sahajanand ERP">
	<description>PHP_CodeSniffer configuration for Sahajanand ERP.</description>

	<!-- Pass some flags to PHPCS:
		 p flag: Show progress of the run.
		 s flag: Show sniff codes in all reports.
		 n flag: Do not print warnings.
	-->
	<arg value="psn"/>

	<!-- Only check the PHP files. JS files are checked by ESLint. -->
	<arg name="extensions" value="php"/>

	<!-- Check all files in this directory and the directories below it. -->
	<file>.</file>

	<!-- Exclude patterns. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/coverage/*</exclude-pattern>
	<exclude-pattern>/artifacts/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/addons/*</exclude-pattern>

	<!-- Allow PSR-4 and standard naming exceptions -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/includes/src/*</exclude-pattern>
		<exclude-pattern>/sahajanand-erp.php</exclude-pattern>
		<exclude-pattern>/addons/*</exclude-pattern>
	</rule>

	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/sahajanand-erp.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid">
		<exclude-pattern>/sahajanand-erp.php</exclude-pattern>
	</rule>

	<!-- Rules: Check PHP version compatibility. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Rules: WordPress Coding Standards -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.PHP.YodaConditions.NotYoda" />
		<exclude name="PEAR.Functions.FunctionCallSignature" />
		<exclude name="Generic.Formatting.MultipleStatementAlignment" />
		<exclude name="WordPress.Arrays.MultipleStatementAlignment" />
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration" />
		<exclude name="Squiz.WhiteSpace.SuperfluousWhitespace" />
		<exclude name="WordPress.NamingConventions.ValidVariableName" />
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing" />
		<exclude name="Generic.ControlStructures.InlineControlStructure" />
		<exclude name="Universal.Operators.DisallowShortTernary" />
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast" />
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent" />
		<exclude name="WordPress.WhiteSpace.OperatorSpacing" />
		<exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions" />
		<exclude name="PSR2.Files.EndFileNewline" />
		<exclude name="WordPress.DateTime.RestrictedFunctions" />
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing" />
		<exclude name="Squiz.ControlStructures.ControlSignature" />
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing" />
		<exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing" />
	</rule>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.DB.PreparedSQL" />
		<exclude name="WordPress.Security.NonceVerification" />
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment" />
		<exclude name="WordPress.WP.I18n.MissingArgDomain" />
	</rule>

	<!-- Verify that the text_domain is set to the desired text-domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sahajanand-erp"/>
			</property>
		</properties>
	</rule>

	<!-- Allow for theme-specific exceptions to the file name rules based on the theme hierarchy. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="false"/>
		</properties>
	</rule>

	<!-- Set the minimum supported WP version. -->
	<config name="minimum_supported_wp_version" value="5.8"/>
</ruleset>
