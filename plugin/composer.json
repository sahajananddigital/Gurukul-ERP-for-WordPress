{
	"name": "sahajanand-erp/sahajanand-erp",
	"description": "WordPress ERP Plugin",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"webklex/php-imap": "^6.2",
		"woocommerce/action-scheduler": "^4.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"php-stubs/wordpress-stubs": "^6.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Sahajanand_ERP\\": "includes/"
		}
	},
	"scripts": {
		"phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist",
		"phpcbf": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
		"phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=1G",
		"test": "vendor/bin/phpunit",
		"test:coverage": "vendor/bin/phpunit --coverage-clover coverage/php/clover.xml",
		"lint": [
			"@phpcs",
			"@phpstan"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		}
	}
}
